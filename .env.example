# Application Settings
APP_NAME='Smart Attendance System'
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=attendance_user
DB_PASSWORD=attendance_pass
DB_NAME=smart_attendance
DB_SCHEMA=public
DATABASE_URL=postgresql+asyncpg://attendance_user:attendance_pass@localhost:5432/smart_attendance

# PgAdmin Settings (optional)
PGADMIN_EMAIL=admin@attendance.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
